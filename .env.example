# Gemini API Key for Veo Video Generation and Native Text-To-Speech
GEMINI_API_KEY=your_api_key_here
GEMINI_API_KEY_2=your_second_api_key_here

# OpenAI API Key for GPT-4o Script Generation and TTS
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key for Ultra-Realistic Voiceovers
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

APP_USERNAME=your_username
APP_PASSWORD=your_password

# Signs logins and video download links. Set a long random value so they survive a server
# restart (without it a new key is generated at every start and everyone is logged out).
JWT_SECRET=

# Lesson video exports (exports.py). Finished videos are stored here; in production point it at a
# persistent volume. Default: ./exports
EXPORTS_DIR=
# Largest accepted recording in bytes (default 8 GB)
EXPORT_MAX_BYTES=

# Asset library (assets.py). Files uploaded to the library are stored here, once per content.
# Local disk like exports; point it at a persistent volume in production. Default: ./assets
ASSETS_DIR=
# Largest accepted library upload in bytes (default 2 GB)
ASSET_MAX_BYTES=

# AI media providers (ai_providers.py / ai_media.py). All optional; empty means the default.
# Order of image providers to try (first = preferred unless AI_IMAGE_PROVIDER says otherwise).
# Default: pollinations,gemini-image
AI_IMAGE_PROVIDERS=
AI_IMAGE_PROVIDER=
# Video providers to fall back to after the one "Start AI Server" chose. Default: veo,ltx
AI_VIDEO_PROVIDERS=
# 0 = never switch to a backup provider (default 1)
AI_PROVIDER_FALLBACK=
# Tries per provider for temporary failures (default 2), longest wait honoured between them in
# seconds (default 20), seconds a failing provider is tried after the others (default 60)
AI_PROVIDER_MAX_ATTEMPTS=
AI_PROVIDER_MAX_RETRY_WAIT=
AI_PROVIDER_COOLDOWN=
# Seconds a provider that refused credentials or asked for payment is tried after the others (600)
AI_PROVIDER_AUTH_COOLDOWN=
# Largest accepted generated image / video in bytes (defaults 20 MB / 500 MB)
AI_MAX_IMAGE_BYTES=
AI_MAX_VIDEO_BYTES=
# Gemini image generation (billed per image): off unless set to 1; model default gemini-2.5-flash-image
GEMINI_IMAGE_ENABLED=
GEMINI_IMAGE_MODEL=
# Veo: 1 = allowed as a backup even when the AI server was started with another profile (billed).
# VEO_MODEL overrides the model (check which models your key can use); VEO_TIMEOUT in seconds (300)
VEO_ENABLED=
VEO_MODEL=
VEO_TIMEOUT=
# Per provider: <NAME>_ENABLED (0 switches it off), <NAME>_TIMEOUT, <NAME>_MAX_CONCURRENT
# for POLLINATIONS, GEMINI_IMAGE, VEO, LTX

# Recovery of interrupted AI generations (ai_runs.py / ai_recovery.py). All optional.
# 0 = do not continue interrupted generations (they are then reported as interrupted). Default 1
AI_RECOVERY_ENABLED=
# Seconds between recovery passes (15); a worker's lease (60) and how often it renews it (15):
# a run whose lease expired (its worker died) is taken over by recovery
AI_RECOVERY_INTERVAL=
AI_JOB_LEASE_SECONDS=
AI_JOB_HEARTBEAT_SECONDS=
# Generations the recovery workers run at once (2), times one run may be recovered before a person
# is asked (3), days finished runs are kept (90)
AI_JOB_CONCURRENCY=
AI_RECOVERY_MAX_ATTEMPTS=
AI_RUN_RETENTION_DAYS=

# Secure Manim rendering (Phase 10: manim_sandbox.py / manim_jobs.py). AI-generated Manim code is
# untrusted: it runs only in an isolated sandbox, never in the server. Without a secure runtime,
# rendering answers "Secure Manim execution is unavailable in this deployment." (no unsafe fallback).
# 0 = no Manim rendering at all. Default 1
MANIM_SANDBOX_ENABLED=
# auto (Windows AppContainer on Windows, else Docker) | windows-appcontainer | docker. Default auto
MANIM_SANDBOX_RUNTIME=
# Where job workspaces live (default %LOCALAPPDATA%\AadhiEduEngine\manim-sandbox); keep the path short
MANIM_SANDBOX_DIR=
# Docker runtime image (build it from sandbox/Dockerfile.manim). Default aadhi-manim-sandbox:0.21.0
MANIM_SANDBOX_IMAGE=
# Windows AppContainer profile name. Default AadhiEduEngine.ManimSandbox
MANIM_SANDBOX_PROFILE=
# Limits (each capped by a hard maximum in manim_security.py). Profiles: preview 854x480@15,
# standard 1280x720@30 (default), high_quality 1920x1080@30
MANIM_TIMEOUT=
MANIM_MEMORY_LIMIT_MB=
MANIM_CPU_LIMIT_PERCENT=
MANIM_MAX_PROCESSES=
MANIM_MAX_OUTPUT_MB=
MANIM_MAX_WORKSPACE_MB=
MANIM_MAX_DURATION=
MANIM_MAX_FPS=
MANIM_MAX_RESOLUTION=
MANIM_MAX_SOURCE_KB=
MANIM_MAX_SCENES=
# Sandboxes at once on the server (1) and per user (2); animations one user may have waiting (10)
# and the whole server (50) before new ones are refused
MANIM_MAX_CONCURRENT=
MANIM_MAX_PER_USER=
MANIM_MAX_QUEUED_PER_USER=
MANIM_MAX_QUEUED=
# Times Gemini may rewrite code that crashed while rendering (2; 0 = never). The rewrite goes
# through the same checks and sandbox. Needs AI generation on and a Gemini key
MANIM_AUTO_HEAL_ATTEMPTS=
