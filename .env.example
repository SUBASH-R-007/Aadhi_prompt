# Aadhi EduEngine v2 configuration.
# GENERATED by scripts/gen_env_example.py from aadhi/config.py - do not edit by hand.
#
# Copy to .env and set what you need; real environment variables override .env.
# Commented lines show the built-in default. Secrets are listed empty: never commit real values.
#
# Offline demo (no API keys, no cost):
#   LLM_PROVIDER=fake  TTS_PROVIDER=fake  IMAGE_PROVIDER=fake  VIDEO_PROVIDER=fake
# Production checklist: APP_ENV=production, JWT_SECRET (>= 32 chars), BASE_URL=https://...,
#   DATABASE_URL=postgresql://..., WORKER_MODE=external, STORAGE_LOCAL_DIR outside the source tree
#   (or STORAGE_BACKEND=s3). See docs/OPERATIONS.md.

# --- Runtime -----------------------------------------------------------------------------------------
# production enables strict startup checks (validate_for_runtime) [options: development | production | test]
# APP_ENV=development
# public origin (share links, render worker, CSRF origin check)
# BASE_URL=http://127.0.0.1:8000
# runtime data: SQLite DB, storage, dev JWT secret, generated admin password
# DATA_DIR=./data
# frontend files served under /web
# WEB_DIR=./web
# mascot clips, bgm, logo, background
# BRANDING_DIR=./video_template
# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO
# IPs allowed to set X-Forwarded-For
# TRUSTED_PROXIES=
# maximum JSON request body
# MAX_JSON_BODY_MB=5

# --- Database ----------------------------------------------------------------------------------------
# default: sqlite:///<data_dir>/aadhi.db [secret]
DATABASE_URL=
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10

# --- Auth / security ---------------------------------------------------------------------------------
# session signing key; required (>= 32 chars) in production, dev generates one under DATA_DIR [secret]
JWT_SECRET=
# session lifetime
# JWT_TTL_HOURS=12
# None = auto (True when base_url is https) [true/false]
# COOKIE_SECURE=
# exact origins; empty = same-origin
# CORS_ORIGINS=
# bootstrap admin account name
# ADMIN_USERNAME=admin
# bootstrap only (when no admin exists) [secret]
ADMIN_PASSWORD=
# minimum password length for new passwords
# PASSWORD_MIN_LENGTH=10
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# API_RATE_LIMIT_PER_MINUTE=300
# GENERATION_RATE_LIMIT_PER_HOUR=20
# SSE_MAX_STREAMS_PER_USER=4
# SSE_MAX_STREAMS_TOTAL=200

# --- Storage -----------------------------------------------------------------------------------------
# [options: local | s3]
# STORAGE_BACKEND=local
# default: <data_dir>/storage
# STORAGE_LOCAL_DIR=
# local backend serving prefix
# MEDIA_URL_PREFIX=/media
# bucket for STORAGE_BACKEND=s3 (S3, Cloudflare R2, MinIO)
# S3_BUCKET=
# S3_REGION=
# R2 / MinIO
# S3_ENDPOINT_URL=
# S3/R2 access key (or use the instance role) [secret]
S3_ACCESS_KEY_ID=
# S3/R2 secret key [secret]
S3_SECRET_ACCESS_KEY=
# key prefix inside the bucket
# S3_PREFIX=aadhi/
# if set, public asset URLs are cdn_base_url + storage key (stable)
# CDN_BASE_URL=
# used only at serve time when no CDN is configured
# S3_PRESIGN_TTL_SECONDS=3600
# maximum upload size
# UPLOAD_MAX_MB=50

# --- Jobs --------------------------------------------------------------------------------------------
# inline = worker threads inside the API process [options: inline | external]
# WORKER_MODE=inline
# worker threads per process
# WORKER_CONCURRENCY=2
# WORKER_KINDS=generate_lecture,regenerate_scene,build_assets,render_video,translate,import_legacy,cleanup
# attempts before a job fails permanently
# JOB_MAX_ATTEMPTS=2
# lease expiry: running job without heartbeat this long is requeued
# JOB_STALE_SECONDS=300
# idle worker poll interval
# JOB_POLL_INTERVAL_SECONDS=1.0
# JOB_EVENT_RETENTION_DAYS=30
# ANALYTICS_RETENTION_DAYS=365

# --- Jobs safety: paid-generation claims and LLM stage checkpoints -----------------------------------
# paid asset kinds generated only once across worker processes, and re-checked as still wanted right before generating (comma list; empty = off)
# GENERATION_CLAIM_KINDS=video,image
# a generation claim expires this long after its last renewal (the holder renews every ttl/4), so a crashed worker's claim is taken over
# GENERATION_CLAIM_TTL_SECONDS=120
# how often a job waiting for another worker's identical generation looks for the result
# GENERATION_CLAIM_POLL_SECONDS=2.0
# longest wait for another worker's generation; then the scene shows a still image and is retried on the next build
# GENERATION_CLAIM_MAX_WAIT_SECONDS=1200
# a retried generate_lecture / translate job reuses the LLM stages its earlier attempt finished (plan, scenes, review, companion sheet, translation) [true/false]
# LLM_STAGE_CHECKPOINTS=true

# --- LLM ---------------------------------------------------------------------------------------------
# default AI engine; a lecture can pick another configured engine; fake = offline deterministic demo mode [options: gemini | openai | anthropic | fake]
# LLM_PROVIDER=gemini
# Gemini model for lecture planning (a gpt-*/claude-* name here configures that engine instead)
# LLM_MODEL_PLAN=gemini-2.5-pro
# Gemini model for scene writing
# LLM_MODEL_SCRIPT=gemini-2.5-flash
# Gemini model for the critic / judge
# LLM_MODEL_CRITIC=gemini-2.5-flash
# Gemini model for small utility calls
# LLM_MODEL_FAST=gemini-2.5-flash
# admin overrides; empty = configured models only
# LLM_MODEL_ALLOWLIST=
# concurrent LLM calls per process
# LLM_MAX_PARALLEL=6
# cap on one attempt of a Gemini / OpenAI LLM call (Claude calls use ANTHROPIC_TIMEOUT_SECONDS)
# LLM_TIMEOUT_SECONDS=600
# longest wait for an OpenAI / Claude call to start answering, plus time to upload a large document; a request with no answer by then is retried (10-600)
# LLM_FIRST_RESPONSE_TIMEOUT_SECONDS=60
# longest silence once an OpenAI answer is streaming (Claude: between keep-alive pings), then the call is retried; OpenAI reasoning steps may stay silent longer (30-1800)
# LLM_IDLE_TIMEOUT_SECONDS=240
# Google AI Studio key (LLM, TTS, images, Veo) [secret]
GEMINI_API_KEY=
# optional pool (rotated on 429) [secret]
GEMINI_API_KEYS=
# OpenAI key (LLM, TTS) [secret]
OPENAI_API_KEY=
# OpenAI engine: lecture planning
# OPENAI_MODEL_PLAN=gpt-4.1
# OpenAI engine: scene writing
# OPENAI_MODEL_SCRIPT=gpt-4.1-mini
# OpenAI engine: critic / judge
# OPENAI_MODEL_CRITIC=gpt-4.1-mini
# OpenAI engine: small utility calls
# OPENAI_MODEL_FAST=gpt-4.1-mini
# Anthropic key (Claude engine) [secret]
ANTHROPIC_API_KEY=
# Claude engine: lecture planning
# ANTHROPIC_MODEL_PLAN=claude-opus-5-5
# Claude engine: scene writing (claude-sonnet-5-5 is a cheaper option)
# ANTHROPIC_MODEL_SCRIPT=claude-opus-5-5
# Claude engine: critic / judge (claude-sonnet-5-5 is a cheaper option)
# ANTHROPIC_MODEL_CRITIC=claude-opus-5-5
# Claude engine: small utility calls (claude-sonnet-5-5 is a cheaper option)
# ANTHROPIC_MODEL_FAST=claude-opus-5-5
# Claude thinking depth / token spend (output_config.effort) [options: low | medium | high | xhigh | max]
# ANTHROPIC_EFFORT=high
# per-call output budget, includes thinking (streamed)
# ANTHROPIC_MAX_TOKENS=64000
# on a safety refusal the API re-runs the request on another Claude model [true/false]
# ANTHROPIC_REFUSAL_FALLBACK=true
# cap on one streamed Claude call (replaces LLM_TIMEOUT_SECONDS for Claude)
# ANTHROPIC_TIMEOUT_SECONDS=1800

# --- API keys saved in the Studio --------------------------------------------------------------------
# master switch for keys saved in the Studio (server and personal) [true/false]
# STORED_API_KEYS_ENABLED=true
# every user may save personal keys, used only for the jobs they start [true/false]
# USER_API_KEYS_ENABLED=true
# Fernet key (urlsafe base64 of 32 bytes); empty = derived from JWT_SECRET (rotating it then requires re-entering saved keys) [secret]
CREDENTIALS_ENCRYPTION_KEY=

# --- TTS ---------------------------------------------------------------------------------------------
# edge is free; fake = deterministic offline audio [options: edge | gemini | openai | elevenlabs | fake]
# TTS_PROVIDER=edge
# empty = language default (aadhi.providers.tts.voices)
# TTS_VOICE=
# edge-tts prosody rate
# TTS_RATE=+0%
# TTS_MAX_PARALLEL=6
# ElevenLabs key (TTS with timestamps) [secret]
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_TTS_MODEL=tts-1-hd
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- Images / video / gifs ---------------------------------------------------------------------------
# pollinations needs no key (its endpoint may ask for payment: HTTP 402, see IMAGE_FALLBACK_PROVIDERS); none disables generated images [options: gemini | pollinations | none | fake]
# IMAGE_PROVIDER=pollinations
# IMAGE_MODEL=gemini-2.5-flash-image
# IMAGE_STYLE_SUFFIX="clean educational illustration, consistent soft lighting, purple and gold accent palette, no text"
# veo generates B-roll within MAX_AI_VIDEOS_PER_LECTURE and the budget [options: veo | none | fake]
# VIDEO_PROVIDER=none
# VEO_MODEL=veo-2.0-generate-001
# MAX_AI_VIDEOS_PER_LECTURE=2
# AI_VIDEO_TIMEOUT_SECONDS=420
# GIPHY key (live-player GIF panels only) [secret]
GIPHY_API_KEY=

# --- Media providers: fallback, cooldowns, output limits ---------------------------------------------
# backups for generated images in order, e.g. gemini (gemini | pollinations | fake); empty = no fallback
# IMAGE_FALLBACK_PROVIDERS=
# backups for AI video in order (veo | fake); empty = no fallback
# VIDEO_FALLBACK_PROVIDERS=
# a provider that just hit a rate limit, outage, timeout or unusable output is tried after the others for this long (per worker process)
# MEDIA_PROVIDER_COOLDOWN_SECONDS=60
# same after a payment/account refusal (HTTP 401/402/403)
# MEDIA_PROVIDER_AUTH_COOLDOWN_SECONDS=600
# generated images above this size are rejected (downloads are streamed with this cap)
# AI_MAX_IMAGE_BYTES=20000000
# generated videos above this size are rejected
# AI_MAX_VIDEO_BYTES=500000000
# requested Veo clip length (billed per second; Veo 2 accepts 5-8); empty = the model's default (8 s)
# VEO_DURATION_SECONDS=
# let APP_ENV=production run with LLM/TTS/IMAGE/VIDEO_PROVIDER=fake (offline demos only) [true/false]
# ALLOW_FAKE_PROVIDERS=false

# --- Manim -------------------------------------------------------------------------------------------
# production free-form Manim requires docker [options: docker | subprocess | disabled]
# MANIM_SANDBOX=subprocess
# image built from docker/manim-sandbox
# MANIM_DOCKER_IMAGE=aadhi-manim-sandbox:latest
# allow model-written Manim code (else templates only) [true/false]
# MANIM_ALLOW_FREEFORM=true
# [options: l | m | h]
# MANIM_QUALITY=m
# wall-clock cap on one render
# MANIM_TIMEOUT_SECONDS=180
# MANIM_MAX_CONCURRENT=2
# MANIM_MAX_REPAIR_ATTEMPTS=2
# vision-model layout check of rendered animations [true/false]
# MANIM_VISUAL_QA=true
# MANIM_BACKGROUND="#1A0B2E"

# --- Manim sandbox hardening -------------------------------------------------------------------------
# per-render memory ceiling (RSS poll); the Windows job uses a looser commit backstop
# MANIM_MEMORY_LIMIT_MB=2048
# docker --cpus for the sandbox container
# MANIM_DOCKER_CPUS=2.0
# Windows job process-count limit (must allow LaTeX's helpers)
# MANIM_MAX_PROCESSES=64
# a render writing more than this to its work dir is stopped
# MANIM_MAX_WORKSPACE_MB=1024
# a finished video larger than this is rejected
# MANIM_MAX_OUTPUT_MB=300
# install the in-sandbox runtime audit hook (defence in depth; kill switch) [true/false]
# MANIM_AUDIT_HOOK=true

# --- Render (MP4) ------------------------------------------------------------------------------------
# RENDER_WIDTH=1920
# RENDER_HEIGHT=1080
# RENDER_FPS=30
# parallel MP4 segment renders per process
# RENDER_CONCURRENCY=3
# RENDER_CRF=20
# RENDER_PRESET=medium
# [true/false]
# RENDER_BURN_CAPTIONS=false
# [true/false]
# RENDER_INCLUDE_INTRO=true
# [true/false]
# RENDER_BGM=true
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Render (MP4): preview parity, output QA, admission, workspace -----------------------------------
# default for renders that do not choose: embed the captions as a selectable mov_text track in the MP4 (not with burn-in; MP4 marks its only caption track enabled, so some players show it at once) [true/false]
# RENDER_SOFT_SUBTITLES=false
# convert overlays/stills to BT.709 and tag the MP4 BT.709 (browser colours); false = untagged BT.601 as before [true/false]
# RENDER_COLOR_BT709=true
# mascot loop keeps its phase across scenes, only the scene layer fades in, 0.6 s crossfade on a position change (as the live player) [true/false]
# RENDER_MASCOT_CONTINUITY=true
# verify every MP4 (frame count, constant frame rate, audio present/audible, black edges) and record the result on the render [true/false]
# RENDER_OUTPUT_QA=true
# active (queued/running) renders per user across all lectures; 0 = unlimited (429 render_busy)
# RENDER_MAX_PER_USER=2
# active renders on the whole server; 0 = unlimited (429 render_queue_full)
# RENDER_MAX_QUEUED=50
# origin the render worker's browser uses to reach the app (e.g. http://api:8000); empty = BASE_URL
# RENDER_BASE_URL=
# resumable render workspaces (segments reused by a retry); empty = <DATA_DIR>/render-work
# RENDER_WORK_DIR=
# keep a failed render's workspace this long so a retry can resume it
# RENDER_KEEP_FAILED_HOURS=24
# refuse to start a render when the workspace disk has less free space (0 = no check)
# RENDER_MIN_FREE_GB=2.0
# panels keep the live player's translucent glass colours over the mascot (without the blur); false = the original solid surfaces [true/false]
# RENDER_GLASS_PANELS=true

# --- Presenter + visual synchronisation (word-anchored moments) --------------------------------------
# formula legend rows, terminal output, side-panel focus pulses and authored highlights follow the spoken word; false = beat-start timing as before [true/false]
# SYNC_WORD_ANCHORS=true
# also highlight a visible board item when the narration names its [[keyword]], definition term or table column (at most 2 per beat, never over an authored highlight) [true/false]
# SYNC_AUTO_EMPHASIS=false

# --- Presenter: Aadhi's behaviour cues ---------------------------------------------------------------
# a small bubble beside Aadhi's head: thinking dots in long pauses and the quiz countdown, "?" while he asks a quiz question, a gold check at the reveal; false = no bubble [true/false]
# MASCOT_CUES=true

# --- Scratch space: temporary work dirs and their housekeeping ---------------------------------------
# private root of the app's temporary work dirs (Manim renders); host sweeps only ever look inside it, never at other folders of the system temp dir; empty = <system temp>/aadhi (aadhi-<uid> on POSIX)
# SCRATCH_DIR=

# --- Lesson quality checks (aadhi/pipeline/quality) --------------------------------------------------
# true = run the AI terminology assistant in the critic stage of generate_lecture [true/false]
# QUALITY_AI_TERMINOLOGY=false

# --- Media library (aadhi/library.py, aadhi/api/routers/library.py) ----------------------------------
# pictures and clips a build generates also join the library of the user who started it (normally the lecture's owner; recorded by the build, a failure there never fails the build) [true/false]
# LIBRARY_AUTO_SAVE_GENERATED=true
# "Suggest a description" in the library: the default AI engine (fast model) proposes a title, description and keywords for one item; billed like every LLM call and counted against the daily budget [true/false]
# LIBRARY_AI_DESCRIBE_ENABLED=false

# --- Budgets / quotas (USD, estimates from aadhi.usage.pricing) --------------------------------------
# budget per generation job
# MAX_COST_PER_LECTURE_USD=5.0
# default per-user daily budget
# DAILY_BUDGET_USD_PER_USER=15.0
# JSON overriding the default price table
# PRICING_FILE=

# --- Generation defaults -----------------------------------------------------------------------------
# default narration language (BCP-47)
# DEFAULT_LANGUAGE=en-IN
# MAX_SOURCE_CHARS=400000
# MAX_SOURCE_PAGES=400

# --- Docker Compose only (docker-compose.yml interpolation; see docs/OPERATIONS.md section 4) -------
# Required by `docker compose`; ADMIN_PASSWORD above is needed only until the first admin exists.
POSTGRES_PASSWORD=
# POSTGRES_USER=aadhi
# POSTGRES_DB=aadhi
# Host port of the API (bound to 127.0.0.1; put a TLS reverse proxy in front)
# AADHI_PORT=8000
# Compose network; the host's reverse proxy appears as the gateway, which is trusted for X-Forwarded-*
# AADHI_SUBNET=172.30.0.0/24
# AADHI_GATEWAY=172.30.0.1
# uvicorn --proxy-headers trust list (default: AADHI_GATEWAY)
# FORWARDED_ALLOW_IPS=172.30.0.1
# Render worker resources
# RENDER_WORKER_CONCURRENCY=1
# RENDER_WORKER_CPUS=4
# RENDER_WORKER_MEMORY=6g
# Image tags
# AADHI_IMAGE=aadhi-eduengine:latest
# AADHI_IMAGE_DOCKER=aadhi-eduengine:docker-cli
# docker-sandbox profile (free-form Manim): host work dir owned by uid 1000, docker group id
# MANIM_HOST_TMP=/var/lib/aadhi/manim-tmp
# DOCKER_GID=999
