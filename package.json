    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-kannada": "5.3.0",
    "@fontsource/noto-sans-malayalam": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@fontsource/noto-sans-telugu": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "chart.js": "4.5.1",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "mathjax": "3.2.2",
    "mathjs": "15.2.0",
    "p5": "1.11.11",
    "prismjs": "1.30.0",
    "three": "0.186.1"
  }
