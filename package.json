{
  "name": "aadhi-eduengine-web",
  "private": true,
  "version": "2.0.0",
  "description": "Frontend (native ES modules) for Aadhi EduEngine v2: tooling only, no bundler.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"web/tests/**/*.test.{js,mjs}\"",
