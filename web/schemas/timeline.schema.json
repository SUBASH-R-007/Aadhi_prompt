  "KenBurns": {
   "description": "Linear pan/zoom over [0, scene.duration]; the CSS player and ffmpeg zoompan both read this.",
   "properties": {
    "start": {
     "$ref": "#/$defs/KenBurnsPoint"
    },
    "end": {
     "$ref": "#/$defs/KenBurnsPoint"
    }
   },
   "title": "KenBurns",
   "type": "object"
  },
