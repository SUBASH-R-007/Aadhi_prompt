{
 "$defs": {
  "BoardItem": {
   "properties": {
    "id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Id",
     "type": "string"
    },
    "kind": {
     "$ref": "#/$defs/BoardItemKind"
    },
    "text": {
     "default": "",
     "maxLength": 1200,
     "title": "Text",
     "type": "string"
    },
    "term": {
     "anyOf": [
      {
       "maxLength": 240,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Term"
    },
    "latex": {
     "anyOf": [
      {
       "maxLength": 1200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Latex"
    },
    "variables": {
     "items": {
      "$ref": "#/$defs/FormulaVariable"
     },
     "maxItems": 8,
     "title": "Variables",
     "type": "array"
    },
    "language": {
     "anyOf": [
      {
       "pattern": "^[a-z0-9+#-]{1,20}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Language"
    },
    "code": {
     "anyOf": [
      {
       "maxLength": 4000,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Code"
    },
    "headers": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "maxItems": 8,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Headers"
    },
    "rows": {
     "anyOf": [
      {
       "items": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "maxItems": 20,
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rows"
    },
    "figure_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Figure Id"
    },
    "caption": {
     "anyOf": [
      {
       "maxLength": 600,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Caption"
    },
    "justification": {
     "anyOf": [
      {
       "maxLength": 800,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Justification"
    },
    "blank": {
     "default": false,
     "title": "Blank",
     "type": "boolean"
    },
    "misconception_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Misconception Id"
    },
    "source_refs": {
     "items": {
      "type": "string"
     },
     "maxItems": 10,
     "title": "Source Refs",
     "type": "array"
    }
   },
   "required": [
    "id",
    "kind"
   ],
   "title": "BoardItem",
   "type": "object"
  },
  "BoardItemKind": {
   "enum": [
    "heading",
    "bullet",
    "paragraph",
    "definition",
    "formula",
    "callout_info",
    "callout_tip",
    "callout_warning",
    "misconception",
    "code",
    "table",
    "figure",
    "example_step",
    "takeaway"
   ],
   "title": "BoardItemKind",
   "type": "string"
  },
  "Branding": {
   "properties": {
    "mascot_clips": {
     "additionalProperties": {
      "type": "string"
