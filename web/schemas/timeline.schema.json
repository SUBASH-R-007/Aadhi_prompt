      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "X Label"
    },
    "y_label": {
     "anyOf": [
      {
       "maxLength": 120,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Y Label"
    }
   },
   "required": [
    "labels",
    "datasets"
   ],
   "title": "ChartSpec",
   "type": "object"
  },
  "ConceptNode": {
   "properties": {
    "id": {
     "maxLength": 64,
     "minLength": 1,
