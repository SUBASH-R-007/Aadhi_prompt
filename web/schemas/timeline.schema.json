  "SyncCue": {
   "description": "A visual moment anchored to a spoken word (``aadhi.compose.sync``); scene-relative seconds.\n\n* ``var``: formula legend row ``part`` (``var:<n>``) of ``item_id`` appears at ``start``;\n* ``emphasis``: board item ``item_id`` is highlighted during ``[start, end)`` and its ``part``\n  (``column:<n>`` of a table, ``term`` of a definition, None = the whole item) emphasised; it\n  replaces the authored highlight of that item in beat ``beat_id``;\n* ``output``: the terminal side panel's output lines start at ``start``;\n* ``focus``: the side panel is pulsed during ``[start, end)``.\n\n``words`` are the spoken words that anchor the cue (shown in the Studio, never to students).",
   "properties": {
    "kind": {
     "enum": [
      "var",
      "emphasis",
      "output",
      "focus"
     ],
     "title": "Kind",
     "type": "string"
    },
    "start": {
     "title": "Start",
     "type": "number"
    },
    "end": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "End"
    },
    "item_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Item Id"
    },
    "part": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Part"
    },
    "beat_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Beat Id"
    },
    "words": {
     "default": "",
     "title": "Words",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "start"
   ],
   "title": "SyncCue",
   "type": "object"
  },
