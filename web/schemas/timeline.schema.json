  "ManimSpec": {
   "description": "Either a library template with typed params (preferred) or free-form code.\n\nFree-form code must define exactly one ``class <Name>(AadhiScene)`` and call\n``self.wait_until_beat(i)`` before the animation step that belongs to beat ``i``.\n``AadhiScene`` and ``BEAT_TIMES`` are injected by ``aadhi.manim``.",
   "properties": {
    "template": {
     "anyOf": [
      {
       "maxLength": 64,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Template"
    },
    "params": {
     "additionalProperties": true,
     "title": "Params",
     "type": "object"
    },
    "code": {
     "anyOf": [
      {
       "maxLength": 20000,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Code"
    }
   },
   "title": "ManimSpec",
   "type": "object"
  },
