    }
   },
   "title": "Branding",
   "type": "object"
  },
  "CaptionCue": {
   "properties": {
    "start": {
     "title": "Start",
     "type": "number"
    },
    "end": {
     "title": "End",
     "type": "number"
    },
    "text": {
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "start",
    "end",
    "text"
   ],
   "title": "CaptionCue",
   "type": "object"
  },
  "Chapter": {
   "properties": {
    "start": {
