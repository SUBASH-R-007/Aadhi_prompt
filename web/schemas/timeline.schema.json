      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "title": "X Range",
     "type": "array"
    },
    "y_range": {
     "anyOf": [
      {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Y Range"
    },
    "x_label": {
     "anyOf": [
      {
       "maxLength": 60,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "X Label"
    },
    "y_label": {
     "anyOf": [
      {
       "maxLength": 60,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Y Label"
    }
   },
   "title": "GraphSpec",
   "type": "object"
  },
