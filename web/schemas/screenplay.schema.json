      {
       "maxLength": 128,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Override Asset Key"
    },
    "variant": {
     "default": 0,
     "maximum": 99,
     "minimum": 0,
     "title": "Variant",
     "type": "integer"
    }
   },
   "required": [
    "id",
    "beats",
    "type",
    "video_prompt"
   ],
   "title": "AIVideoScene",
   "type": "object"
  },
