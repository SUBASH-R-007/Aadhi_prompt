{
 "$defs": {
  "AIVideoScene": {
   "description": "Real-world footage. Narration plays over a looping clip.\n\nIf AI video is disabled, over budget or fails, the asset stage produces a still from\n``fallback_image_prompt`` (or uses ``fallback_figure_id``) shown with a Ken-Burns pan.",
   "properties": {
    "id": {
     "maxLength": 64,
     "minLength": 1,
     "title": "Id",
     "type": "string"
    },
    "concept_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Concept Id"
    },
    "chapter_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Chapter Id"
    },
    "title": {
     "default": "",
     "maxLength": 240,
     "title": "Title",
     "type": "string"
    },
    "subtitle": {
     "anyOf": [
      {
       "maxLength": 320,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Subtitle"
    },
    "mascot_position": {
     "default": "left",
     "enum": [
      "left",
      "right",
      "center",
      "popup_bottom_left",
      "popup_bottom_right",
      "hidden"
     ],
     "title": "Mascot Position",
     "type": "string"
    },
    "beats": {
     "items": {
      "$ref": "#/$defs/Beat"
     },
     "maxItems": 40,
     "minItems": 1,
     "title": "Beats",
     "type": "array"
    },
    "side_panel": {
     "anyOf": [
      {
       "$ref": "#/$defs/SidePanel"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "objective_ids": {
     "items": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 10,
     "title": "Objective Ids",
     "type": "array"
    },
    "intent": {
     "anyOf": [
      {
       "$ref": "#/$defs/SceneIntent"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "notes": {
     "default": "",
     "maxLength": 4000,
     "title": "Notes",
     "type": "string"
    },
    "hidden": {
     "default": false,
     "title": "Hidden",
     "type": "boolean"
    },
    "min_seconds": {
     "anyOf": [
      {
       "maximum": 600.0,
       "minimum": 1.0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Min Seconds"
    },
    "type": {
     "const": "ai_video",
     "title": "Type",
     "type": "string"
    },
    "video_prompt": {
     "maxLength": 1200,
     "minLength": 1,
     "title": "Video Prompt",
     "type": "string"
    },
    "rationale": {
     "default": "",
     "maxLength": 400,
     "title": "Rationale",
     "type": "string"
    },
    "fallback_image_prompt": {
     "anyOf": [
      {
       "maxLength": 800,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Fallback Image Prompt"
    },
    "fallback_figure_id": {
     "anyOf": [
      {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Fallback Figure Id"
    },
