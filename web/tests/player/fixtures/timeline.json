 "captions": [
  {
   "start": 12.0,
   "end": 15.0,
   "text": "Welcome! Today we meet Ohm's law."
  },
  {
   "start": 16.3,
   "end": 18.8,
   "text": "Resistance opposes the flow of current."
  },
  {
   "start": 18.95,
   "end": 21.8,
   "text": "Ohm's law links voltage, current and resistance."
  },
  {
   "start": 22.95,
   "end": 24.8,
   "text": "Resistance is measured in ohms."
  },
  {
   "start": 24.95,
   "end": 26.8,
   "text": "Tip: keep units consistent."
  },
  {
   "start": 26.95,
   "end": 28.8,
   "text": "Careful with hot resistors."
  },
  {
   "start": 28.95,
   "end": 30.8,
   "text": "A common mistake is thinking current is used up."
  },
  {
   "start": 30.95,
   "end": 32.8,
   "text": "Remember: V equals I R."
  },
  {
   "start": 32.95,
   "end": 34.8,
   "text": "Let's practise next."
  },
  {
   "start": 40.1,
   "end": 41.95,
   "text": "We know V and R."
  },
  {
   "start": 42.1,
   "end": 43.95,
   "text": "Which formula gives the current?"
  },
  {
   "start": 46.1,
   "end": 47.95,
   "text": "Divide voltage by resistance."
  },
  {
   "start": 48.1,
   "end": 49.95,
   "text": "Now substitute the numbers."
  },
  {
   "start": 52.1,
   "end": 53.95,
   "text": "Three amperes."
  },
  {
   "start": 54.1,
   "end": 55.95,
   "text": "In code it looks like this."
  },
  {
   "start": 56.1,
   "end": 57.95,
   "text": "Here are a few more values."
  },
  {
   "start": 58.1,
   "end": 59.95,
   "text": "And the circuit diagram."
  },
  {
   "start": 61.25,
   "end": 64.25,
   "text": "Watch the current change."
  },
  {
   "start": 64.4,
   "end": 67.4,
   "text": "Double the voltage, double the current."
  },
  {
   "start": 68.7,
   "end": 72.7,
   "text": "Power lines carry current across the city."
  },
  {
   "start": 74.0,
   "end": 77.0,
   "text": "If V is 10 volts and R is 5 ohms, what is I?"
  },
  {
   "start": 82.15,
   "end": 85.15,
   "text": "It is 2 amperes, because I equals V over R."
  },
  {
   "start": 87.45,
   "end": 90.45,
   "text": "Drag the slider and watch the current."
  }
 ],
