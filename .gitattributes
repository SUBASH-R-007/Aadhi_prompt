# Line endings: shell scripts must stay LF (Docker), text normalised in the repo.
* text=auto
*.sh text eol=lf
docker/** text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
# Binary fixtures and media
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.woff2 binary
# Generated (scripts/gen_third_party_notices.py; its --check compares bytes)
THIRD_PARTY_NOTICES text eol=lf
