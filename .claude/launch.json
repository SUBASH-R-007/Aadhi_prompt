{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aadhi-server",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "server.py"
      ],
      "port": 8000
    },
    {
      "name": "aadhi-worker",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "aadhi.worker"
      ]
    },
    {
      "name": "aadhi-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/dev_demo.py"
      ],
      "port": 8010
    }
  ]
}
