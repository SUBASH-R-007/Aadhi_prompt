 "total_duration": 62.15,
 "chapters": [
  {
   "start": 0.0,
   "title": "What a wave is"
  },
  {
   "start": 26.15,
   "title": "Wave speed"
  }
 ],
 "captions": [
  {
   "start": 5.5,
   "end": 7.409,
   "text": "Why do you see\nthe lightning"
  },
  {
   "start": 7.409,
   "end": 9.0,
   "text": "before you hear\nthe thunder?"
  },
  {
   "start": 9.15,
   "end": 11.35,
   "text": "By the end of\nthis lesson you"
  },
  {
   "start": 11.35,
   "end": 13.55,
   "text": "will be able\nto work it out."
  },
  {
   "start": 14.85,
   "end": 16.139,
   "text": "A wave\ncarries energy"
  },
  {
   "start": 16.139,
   "end": 17.75,
   "text": "from one place\nto another."
  },
  {
   "start": 17.9,
   "end": 19.167,
   "text": "The medium\nitself only"
  },
  {
   "start": 19.167,
   "end": 20.433,
   "text": "moves back\nand forth"
  },
  {
   "start": 20.433,
   "end": 21.7,
   "text": "around where\nit was."
  },
  {
   "start": 21.85,
   "end": 23.759,
   "text": "Sound in air\nand light from"
  },
  {
   "start": 23.759,
   "end": 25.35,
   "text": "the sun are\nboth waves."
  },
  {
   "start": 26.65,
   "end": 27.617,
   "text": "The\nwavelength is"
  },
  {
   "start": 27.617,
   "end": 28.906,
   "text": "the distance\nbetween two"
  },
  {
   "start": 28.906,
   "end": 29.55,
   "text": "neighbouring\ncrests."
  },
  {
   "start": 29.7,
   "end": 30.962,
   "text": "We write it with"
  },
  {
   "start": 30.962,
   "end": 32.538,
   "text": "the Greek letter\nlambda and"
  },
  {
   "start": 32.538,
   "end": 33.8,
   "text": "measure it\nin metres."
  },
  {
   "start": 35.1,
   "end": 36.1,
   "text": "Wave speed\nequals"
  },
  {
   "start": 36.1,
   "end": 37.1,
   "text": "frequency times\nwavelength."
  },
  {
   "start": 37.25,
   "end": 38.841,
   "text": "Speed in metres\nper second,"
  },
  {
   "start": 38.841,
   "end": 39.795,
   "text": "frequency\nin hertz,"
  },
  {
   "start": 39.795,
   "end": 40.75,
   "text": "wavelength\nin metres."
  },
  {
   "start": 40.9,
   "end": 42.173,
   "text": "Double the\nfrequency at"
  },
  {
   "start": 42.173,
   "end": 43.445,
   "text": "the same\nspeed and"
  },
  {
   "start": 43.445,
   "end": 44.4,
   "text": "the wavelength\nhalves."
  },
  {
   "start": 45.7,
   "end": 47.609,
   "text": "Try this one.\nPause the video"
  },
  {
   "start": 47.609,
   "end": 49.2,
   "text": "if you need\nmore time."
  },
  {
   "start": 52.35,
   "end": 53.664,
   "text": "Six metres\nper second:"
  },
  {
   "start": 53.664,
   "end": 54.65,
   "text": "two times three."
  },
  {
   "start": 56.95,
   "end": 58.521,
   "text": "Next time\nwe use this"
  },
  {
   "start": 58.521,
   "end": 59.779,
   "text": "to explain\nhow we"
  },
  {
   "start": 59.779,
   "end": 61.35,
   "text": "hear sound.\nSee you then."
  }
 ],
