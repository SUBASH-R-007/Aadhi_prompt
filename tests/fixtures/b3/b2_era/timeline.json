 "total_duration": 61.91,
 "chapters": [
  {
   "start": 0.0,
   "title": "Introduction"
  },
  {
   "start": 9.71,
   "title": "Waves"
  }
 ],
 "captions": [
  {
   "start": 5.53,
   "end": 8.91,
   "text": "Today we find out how fast\na wave travels, and why."
  },
  {
   "start": 10.24,
   "end": 11.14,
   "text": "Part 1: Waves."
  },
  {
   "start": 12.47,
   "end": 15.23,
   "text": "A wave carries energy\nfrom one place to another."
  },
  {
   "start": 15.41,
   "end": 19.1,
   "text": "The medium itself only moves back\nand forth around where it was."
  },
  {
   "start": 19.28,
   "end": 22.66,
   "text": "Sound in air and light from\nthe sun are both waves."
  },
  {
   "start": 23.99,
   "end": 27.06,
   "text": "Drop a stone in a pond\nand ripples spread out."
  },
  {
   "start": 27.24,
   "end": 30.31,
   "text": "The water stays where it is;\nthe energy moves outwards."
  },
  {
   "start": 31.64,
   "end": 33.47,
   "text": "Wave speed equals\nfrequency times wavelength."
  },
  {
   "start": 33.65,
   "end": 37.03,
   "text": "Speed in metres per second, frequency\nin hertz, wavelength in metres."
  },
  {
   "start": 37.21,
   "end": 40.59,
   "text": "Double the frequency at the same\nspeed and the wavelength halves."
  },
  {
   "start": 41.92,
   "end": 45.3,
   "text": "Try this one. Pause the\nvideo if you need more time."
  },
  {
   "start": 50.48,
   "end": 52.62,
   "text": "Six metres per second: two times three."
  },
  {
   "start": 54.95,
   "end": 56.78,
   "text": "A wave carries energy, not matter."
  },
  {
   "start": 56.96,
   "end": 58.79,
   "text": "Its speed is frequency times wavelength."
  },
  {
   "start": 58.97,
   "end": 61.11,
   "text": "And that speed depends on the medium."
  }
 ],
